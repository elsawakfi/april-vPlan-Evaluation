import json
from pathlib import Path

import streamlit as st

from extractor import run_design_tool


# ==========================================================
# PAGE CONFIGURATION
# ==========================================================

st.set_page_config(
    page_title="Specification Requirement Extractor",
    page_icon="📄",
    layout="wide"
)


# ==========================================================
# TITLE AND DESCRIPTION
# ==========================================================

st.title("Specification Requirement Extractor")

st.write(
    "Upload a protocol specification PDF to extract structured "
    "requirements, sections, tables, notes, acronyms, "
    "cross-references, and semantic chunks."
)


# ==========================================================
# INPUT
# ==========================================================

st.header("Input Specification")

uploaded_pdf = st.file_uploader(
    "Select a specification PDF",
    type=["pdf"],
    accept_multiple_files=False
)

generate = st.button(
    "Extract Requirements",
    type="primary"
)


# ==========================================================
# PROCESSING AND OUTPUT
# ==========================================================

if generate:

    if uploaded_pdf is None:
        st.error("Please select a PDF specification.")

    else:
        try:
            with st.spinner(
                "Extracting requirements from the specification..."
            ):
                result_log, result_file_path = run_design_tool(
                    uploaded_file=uploaded_pdf
                )

            st.success(
                "Requirement extraction completed successfully."
            )

            result_path = Path(result_file_path)

            if not result_path.exists():
                st.error(
                    "Extraction completed, but the generated JSON "
                    "file could not be found."
                )

            else:
                with result_path.open(
                    "r",
                    encoding="utf-8"
                ) as file:
                    result_data = json.load(file)

                # ==================================================
                # EXTRACTION SUMMARY
                # ==================================================

                st.header("Extraction Results")

                col1, col2, col3, col4 = st.columns(4)

                col1.metric(
                    "Requirements",
                    len(result_data.get("requirements", []))
                )

                col2.metric(
                    "Sections",
                    len(result_data.get("sections", []))
                )

                col3.metric(
                    "Tables",
                    len(result_data.get("tables", []))
                )

                col4.metric(
                    "Pages Processed",
                    len(result_data.get("pages", []))
                )

                col5, col6, col7 = st.columns(3)

                col5.metric(
                    "Notes",
                    len(result_data.get("notes", []))
                )

                col6.metric(
                    "Acronyms",
                    len(result_data.get("acronyms", []))
                )

                col7.metric(
                    "Cross-References",
                    len(result_data.get("cross_references", []))
                )


                # ==================================================
                # REQUIREMENTS
                # ==================================================

                st.subheader("Extracted Requirements")

                requirements = result_data.get(
                    "requirements",
                    []
                )

                if requirements:
                    requirement_rows = []

                    for requirement in requirements:
                        requirement_rows.append({
                            "ID": requirement.get("id"),
                            "Section": requirement.get(
                                "source_section"
                            ),
                            "Type": requirement.get("type"),
                            "Requirement": requirement.get("text"),
                            "Signals": ", ".join(
                                requirement.get("signals", [])
                            )
                        })

                    st.dataframe(
                        requirement_rows,
                        use_container_width=True,
                        hide_index=True
                    )

                else:
                    st.info(
                        "No requirements were extracted."
                    )


                # ==================================================
                # SECTIONS
                # ==================================================

                with st.expander("Detected Sections"):
                    sections = result_data.get(
                        "sections",
                        []
                    )

                    if sections:
                        st.dataframe(
                            sections,
                            use_container_width=True,
                            hide_index=True
                        )

                    else:
                        st.write(
                            "No sections were detected."
                        )


                # ==================================================
                # TABLES
                # ==================================================

                with st.expander("Extracted Tables"):
                    tables = result_data.get(
                        "tables",
                        []
                    )

                    if tables:
                        st.dataframe(
                            tables,
                            use_container_width=True,
                            hide_index=True
                        )

                    else:
                        st.write(
                            "No tables were extracted."
                        )


                # ==================================================
                # NOTES
                # ==================================================

                with st.expander("Extracted Notes"):
                    notes = result_data.get(
                        "notes",
                        []
                    )

                    if notes:
                        st.dataframe(
                            notes,
                            use_container_width=True,
                            hide_index=True
                        )

                    else:
                        st.write(
                            "No notes were extracted."
                        )


                # ==================================================
                # ACRONYMS
                # ==================================================

                with st.expander("Detected Acronyms"):
                    acronyms = result_data.get(
                        "acronyms",
                        []
                    )

                    if acronyms:
                        st.write(", ".join(acronyms))

                    else:
                        st.write(
                            "No acronyms were detected."
                        )


                # ==================================================
                # CROSS-REFERENCES
                # ==================================================

                with st.expander("Detected Cross-References"):
                    cross_references = result_data.get(
                        "cross_references",
                        []
                    )

                    if cross_references:
                        for reference in cross_references:
                            st.write(f"- {reference}")

                    else:
                        st.write(
                            "No cross-references were detected."
                        )


                # ==================================================
                # PROCESSING LOG
                # ==================================================

                with st.expander("Processing Log"):
                    st.text_area(
                        "Parser Output",
                        value=result_log,
                        height=300,
                        disabled=True
                    )


                # ==================================================
                # JSON DOWNLOAD
                # ==================================================

                st.subheader("Generated Structured Output")

                st.write(
                    f"Output file: `{result_path.name}`"
                )

                st.download_button(
                    label="Download Extracted JSON",
                    data=result_path.read_bytes(),
                    file_name=result_path.name,
                    mime="application/json"
                )

        except Exception as error:
            st.error(
                f"Requirement extraction failed: {error}"
            )